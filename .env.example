# ODOS — local dev environment
# Copy to .env and fill in. Never commit .env (it's in .gitignore).

# Medplum server (set via medplum.config.json for dev; here for dev scripts)
MEDPLUM_BASE_URL=http://localhost:8103
# Repoints Medplum invite and password-reset email links to the ODOS UI.
# A medplum-server restart is required after changing this value. After any
# restart, re-verify practice roles until the role-desynchronization fix ships.
MEDPLUM_APP_BASE_URL=http://localhost:5173
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# Practice setup wizard — human-provisioned credentials
ODOS_PRACTICE_NAME="ODOS Local Practice"
ODOS_ADMIN_EMAIL=admin@odos.local
ODOS_ADMIN_NAME="ODOS Admin"
ODOS_ADMIN_PASSWORD=
ODOS_SETUP_INTERACTIVE_ACK=
ODOS_MCP_BASE_URL=http://localhost:3333

# Medplum service credentials used by local integration scripts
MEDPLUM_ADMIN_EMAIL=admin@odos.local
MEDPLUM_ADMIN_PASSWORD=
ODOS_POSTGRES_URL=postgresql://medplum:medplum@127.0.0.1:5432/medplum
ODOS_BACKUP_DIR=./backup
ODOS_ERA_UNDERPAYMENT_THRESHOLD_CENTS=1

# Optical lab-order transport. Leave manual until Ocuco completes the one-time PIN exchange.
ODOS_LAB_ORDER_VENDOR_DEFAULT=manual
OCUCO_GATEKEEPER_BASE_URL=
OCUCO_GATEKEEPER_JWT_KEY=
OCUCO_GATEKEEPER_JWT_SECRET=

# AMA CPT API — token from https://platform.ama-assn.org/ama/ dev portal
# Not used yet; loader comes post-Chacon call
AMA_CPT_API_TOKEN=
