# ODOS — local dev environment
# Copy to .env and fill in. Never commit .env (it's in .gitignore).

# Medplum server (set via medplum.config.json for dev; here for dev scripts)
MEDPLUM_BASE_URL=http://localhost:8103
# Public origin Medplum signs storage URLs with. Leave unset for a default install.
# Set it if you remap the storage port or serve storage from another host — otherwise
# signed attachment URLs point at the default origin and fetches fail with
# 401 "Invalid signature" (no WWW-Authenticate header, nothing in the server log).
# MEDPLUM_STORAGE_BASE_URL=http://localhost:8103/storage/
# Repoints Medplum invite and password-reset email links to the ODOS UI.
# A medplum-server restart is required after changing this value. After any
# restart, re-verify practice roles until the role-desynchronization fix ships.
MEDPLUM_APP_BASE_URL=http://localhost:5173
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# The browser UI requires the local HTTP/SSE transport. Use stdio only for launch-on-demand MCP clients.
ODOS_MCP_TRANSPORT=sse

# Practice setup wizard — human-provisioned credentials
ODOS_PRACTICE_NAME="ODOS Local Practice"
ODOS_ADMIN_EMAIL=your-email@example.com
ODOS_ADMIN_NAME="ODOS Admin"
ODOS_ADMIN_PASSWORD=
ODOS_SETUP_INTERACTIVE_ACK=
ODOS_MCP_BASE_URL=http://localhost:3333
# Generate this RSA-2048 private key with the command in docs/install.md; keep it mode 0600 and out of git.
# Use an absolute path because the backend starts with mcp/ as its working directory.
ODOS_SMART_SIGNING_KEY_PATH=/absolute/path/to/ODOS2020/.odos/keys/smart-signing.pem

# Medplum service credentials used by local integration scripts
MEDPLUM_ADMIN_EMAIL=admin@odos.local
MEDPLUM_ADMIN_PASSWORD=
# Required for Medplum outbound email. Keep provider and SMTP credentials server-only.
MEDPLUM_EMAIL_PROVIDER=
MEDPLUM_SUPPORT_EMAIL=
MEDPLUM_SMTP_HOST=
MEDPLUM_SMTP_PORT=
MEDPLUM_SMTP_USERNAME=
MEDPLUM_SMTP_PASSWORD=
ODOS_POSTGRES_URL=postgresql://medplum:medplum@127.0.0.1:5433/medplum
ODOS_BACKUP_DIR=./backup
ODOS_ERA_UNDERPAYMENT_THRESHOLD_CENTS=1

# Optical lab-order transport. Leave manual until Ocuco completes the one-time PIN exchange.
ODOS_LAB_ORDER_VENDOR_DEFAULT=manual
OCUCO_GATEKEEPER_BASE_URL=
OCUCO_GATEKEEPER_JWT_KEY=
OCUCO_GATEKEEPER_JWT_SECRET=

# WestFax outbound fax transport. ProductId is discovered once with
# Profile_GetProductList and then stored here; credentials remain server-only.
WESTFAX_USERNAME=
WESTFAX_PASSWORD=
WESTFAX_PRODUCT_ID=
WESTFAX_CALLBACK_BASE_URL=

# Native communications. Leave ODOS_COMMS_PROVIDERS empty to keep the layer inert.
# The service-account key is a per-practice secret; preserve PEM newlines or encode them as \n.
ODOS_COMMS_PROVIDERS=
# Optional explicit role assignments, for example:
# voice=twilio,transactional-sms=twilio,marketing-sms=ghl,email=google-workspace
ODOS_COMMS_CHANNEL_ROUTES=
ODOS_TIMEZONE=America/New_York
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WORKSPACE_PRIVATE_KEY=
GOOGLE_WORKSPACE_DELEGATED_USER=
GOOGLE_WORKSPACE_DOMAIN=
GOOGLE_WORKSPACE_FROM_ADDRESS=
GOOGLE_WORKSPACE_PLAN_CONFIRMED=false
# Per-practice HighLevel sub-account credentials. The token must be a location-scoped OAuth
# access token or Private Integration Token with contacts and conversations scopes.
GHL_LOCATION_ID=
GHL_ACCESS_TOKEN=
# Per-practice Twilio account. API keys are recommended for production sends; the Auth Token
# remains required to validate X-Twilio-Signature on inbound and status webhooks.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# In HIPAA mode a Restricted key also needs twilio/messaging/services.phonenumbers/list.
TWILIO_MESSAGING_SERVICE_SID=
# Used only when no Messaging Service SID is configured; E.164 format required.
# In HIPAA mode this number and every enumerated Messaging Service sender must be US.
TWILIO_FROM_NUMBER=
# Voice is enabled only when all five values are present. Use a separate Restricted API key with
# Voice call create/read/list and recording-read permissions; do not widen the Messaging key.
TWILIO_VOICE_FROM_NUMBER=
TWILIO_VOICE_FORWARD_TO_NUMBER=
# Exact public HTTPS origin Twilio is configured to call; signature validation depends on it.
TWILIO_WEBHOOK_BASE_URL=
TWILIO_VOICE_API_KEY_SID=
TWILIO_VOICE_API_KEY_SECRET=
# HIPAA posture rejects non-US SMS/Voice destinations and explicit senders. Leave false for non-US deployments.
ODOS_HIPAA_MODE=false
# Opt-in webhook-only Real-Time Transcription. ODOS does not expose Batch Transcription v3.
TWILIO_REAL_TIME_TRANSCRIPTION_ENABLED=false
# Set true only after enabling "Enforce HTTP Auth on Media URLs" in Twilio Voice Settings.
# Twilio does not expose this account setting through its documented REST API.
TWILIO_MEDIA_URL_AUTH_ACKNOWLEDGED=false
# The engine remains off until each selected provider's BAA/setup is manually confirmed.
ODOS_REMINDER_ENGINE_ENABLED=false
# Comma-separated email, sms, or both. ODOS_REMINDER_PROVIDER remains the email fallback.
ODOS_REMINDER_CHANNELS=email
ODOS_REMINDER_PROVIDER=google-workspace
ODOS_REMINDER_EMAIL_PROVIDER=google-workspace
ODOS_REMINDER_SMS_PROVIDER=twilio
ODOS_REMINDER_WORKER_MS=60000
# Positive-offset campaign recovery window; negative reminders recover while the anchor is upcoming.
ODOS_REMINDER_LOOKBACK_MINUTES=1440
# HTTPS practice-domain origin used when a campaign generates tracked redirect links.
ODOS_COMMS_PUBLIC_BASE_URL=

# AMA CPT API — token from https://platform.ama-assn.org/ama/ dev portal
# Not used yet; loader comes post-Chacon call
AMA_CPT_API_TOKEN=

# WENO Switch API — certification environment only
WENO_SWITCH_PARTNER_ID=
WENO_SWITCH_PARTNER_PASSWORD_MD5=
WENO_SWITCH_ROUTING_ID=
WENO_SWITCH_SENDER_SOFTWARE_DEVELOPER=
WENO_SWITCH_SENDER_SOFTWARE_VERSION=
# Defaults to the WENO certification endpoint. Supply the verified production endpoint at go-live.
WENO_SWITCH_ENDPOINT=
