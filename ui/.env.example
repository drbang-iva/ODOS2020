# Copy to ui/.env. Never commit the real .env.
# The Vite server and browser can reach MCP at different URLs during tunneled or remote development.
# Server-only Vite proxy target; no VITE_ prefix means it is not inlined into the browser bundle.
ODOS_MCP_PROXY_TARGET=http://localhost:3333
# Browser-facing absolute MCP URL used by client APIs that do not go through the Vite proxy.
VITE_ODOS_MCP_BASE_URL=http://localhost:3333
