{
  "name": "odos2020",
  "version": "0.0.1",
  "description": "Open Source Optometry — practitioner-owned EHR on Medplum FHIR foundation",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "bin": {
    "odos": "./scripts/odos.ts"
  },
  "scripts": {
    "up": "docker-compose up -d",
    "down": "docker-compose down",
    "reset": "docker-compose down -v",
    "logs": "docker-compose logs -f medplum-server",
    "poc": "tsx src/index.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "seed-scheduler": "tsx scripts/seed-scheduler-demo.ts",
    "seed-dry-eye-treatment": "tsx --env-file-if-exists=.env scripts/seed-dry-eye-treatment.ts",
    "install-profiles": "tsx scripts/install-profiles.ts",
    "setup-practice": "tsx scripts/setup-practice.ts",
    "generate-medplum-signing-keys": "tsx scripts/generate-medplum-signing-keys.ts",
    "setup-legacy-importer": "tsx --env-file-if-exists=.odos/migration-importer.env scripts/setup-legacy-importer.ts",
    "gate:legacy-import-m2a": "tsx --env-file-if-exists=.env scripts/gate-legacy-import-m2a.ts",
    "generate-legacy-patient-manifests": "tsx scripts/generate-legacy-patient-manifests.ts",
    "generate-legacy-visit-manifests": "tsx scripts/generate-legacy-visit-manifests.ts",
    "import-legacy-patient-m2a": "tsx --env-file-if-exists=.odos/migration-importer.env scripts/import-legacy-patient-m2a.ts",
    "import-legacy-visits-m2b1": "tsx --env-file-if-exists=.odos/migration-importer.env scripts/import-legacy-visits-m2b1.ts",
    "import-legacy-visits-m2b2": "tsx --env-file-if-exists=.odos/migration-importer.env scripts/import-legacy-visits-m2b2.ts",
    "adjudicate-legacy-import-m2b2": "tsx scripts/adjudicate-legacy-import-m2b2.ts",
    "import-legacy-bulk-m2b2": "tsx --env-file-if-exists=.odos/migration-importer.env scripts/import-legacy-bulk-m2b2.ts",
    "grant-migrated-patient-access": "tsx --env-file-if-exists=.odos/migration-importer.env scripts/grant-migrated-patient-access.ts",
    "verify-legacy-import-m2a": "tsx --env-file-if-exists=.odos/migration-importer.env scripts/verify-legacy-import-m2a.ts",
    "sweep-legacy-import-binaries": "tsx --env-file-if-exists=.odos/migration-importer.env scripts/sweep-legacy-import-binaries.ts",
    "verify-legacy-import-m0": "tsx --env-file-if-exists=.odos/migration-importer.env scripts/verify-legacy-import-m0.ts",
    "backfill-patient-mrns": "tsx --env-file-if-exists=.env scripts/backfill-patient-mrns.ts",
    "repair-practice-roles": "tsx --env-file-if-exists=.env scripts/repair-practice-roles.ts",
    "cleanup-practice-role-memberships": "tsx --env-file-if-exists=.env scripts/cleanup-practice-role-memberships.ts",
    "reseed-role-tags": "tsx scripts/reseed-practice-role-tags.ts",
    "seed-demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "preflight": "tsx scripts/preflight-lint.ts",
    "dr-drill": "tsx scripts/dr-drill.ts",
    "audit-verify": "tsx scripts/verify-tier1-visit-audit.ts",
    "agentops:migration-type-regen": "tsx scripts/agentops-migration-type-regen.ts",
    "verify-backup-destination": "tsx scripts/verify-backup-destination.ts"
  },
  "dependencies": {
    "@medplum/fhirtypes": "^4.0.0",
    "csv-parse": "^7.0.1"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
